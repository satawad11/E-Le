# Root .gitignore — เพิ่มใน LEGACY-00 เพื่อไม่ให้ cache ของ package manager
# เข้าไปอยู่ใน baseline commit (.pnpm-store มีสำเนาซอร์ส frontend ทั้งชุด)

.pnpm-store/
node_modules/
.DS_Store
Thumbs.db

# Database/storage dumps มีข้อมูลจริง (password hash, เลขบัตรประชาชนที่เข้ารหัส,
# ลายเซ็น, ใบรับรองแพทย์) — ห้าม commit เข้า repo เด็ดขาด
# เก็บไว้นอก repo หรือใน secure backup storage เท่านั้น
docs/checkpoints/*/backups/
*.sql.gz
*.dump

# ไฟล์ env ของ docker compose มี DB credential จริง — ห้าม commit
.env
.env.*
!.env.example
