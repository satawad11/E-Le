APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

# URL ของหน้าเว็บฝั่งผู้ใช้ — ใช้สร้างลิงก์ใน QR ตรวจสอบใบลา
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=structured
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Module Registry deployment switches (dependencies disable transitively)
MODULE_LEAVE_ENABLED=true
MODULE_ATTENDANCE_ENABLED=true
MODULE_OVERTIME_ENABLED=true
MODULE_SARABAN_ENABLED=true
MODULE_NOTIFICATION_ENABLED=true
MODULE_REPORTING_ENABLED=true

# Document & Report Engine — ออกเอกสารจากแบบฟอร์ม PDF ต้นฉบับแทนเส้นทางพิมพ์เดิม
# ปิดอยู่ = ระบบพิมพ์เอกสารด้วยเส้นทางเดิมทั้งหมด (ค่าเริ่มต้นที่ปลอดภัย)
# เปิดแล้วยังต้องระบุประเภทการลาที่อนุญาตด้านล่างอีกชั้น จึงทยอยเปิดทีละประเภทได้
DOCUMENT_ENGINE_ENABLED=false
# ระบุ id ของประเภทการลาคั่นด้วยจุลภาค เช่น 5,6 หรือใส่ * เพื่อเปิดทุกประเภท
DOCUMENT_ENGINE_LEAVE_TYPES=
# เก็บไฟล์เอกสารทุกครั้งที่ออก (ปกติเก็บเฉพาะฉบับสมบูรณ์ของใบลาที่อนุมัติแล้ว)
DOCUMENT_ENGINE_STORE_EVERY_RENDER=false

# บัญชีผู้ดูแลระบบเริ่มต้น (SEC-028)
# ตอนติดตั้งครั้งแรก `php artisan db:seed --force` จะสร้างผู้ดูแลระบบให้หนึ่งบัญชี
# ถ้าไม่ตั้ง ADMIN_PASSWORD ระบบจะสุ่มรหัสผ่านให้แล้วพิมพ์บนหน้าจอเพียงครั้งเดียว
ADMIN_EMAIL=
ADMIN_PASSWORD=
# เปิดเฉพาะบนเครื่องทดสอบเท่านั้น — สร้างบัญชีตัวอย่างครบทุกบทบาทด้วยรหัสผ่านที่เดาได้
SEED_DEMO_ACCOUNTS=false
